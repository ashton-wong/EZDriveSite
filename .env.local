# Local environment overrides for form forwarding and demo testing.
# Replace the placeholders with your real Google Form IDs before running.
GOOGLE_FORMS_URL="https://docs.google.com/forms/d/e/1FAIpQLSfYGn4c0DuutVq_mhXF_xsIC-SSOhYY6RCDkIc9P_cpyvHR1Q/formResponse"

# JSON mapping of client payload keys to Google Form entry names. Example:
# {"email":"entry.111111111","name":"entry.222222222"}
GOOGLE_FORMS_MAPPING='{"email":"entry.111111111","name":"entry.222222222"}'

# Public URL to the Google Form view (used for the fallback CTA/banner)
NEXT_PUBLIC_GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/1FAIpQLSfYGn4c0DuutVq_mhXF_xsIC-SSOhYY6RCDkIc9P_cpyvHR1Q/viewform"
